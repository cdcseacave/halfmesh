{
  "name": "halfmesh",
  "version": "0.4.0",
  "description": "Fast, compact half-edge triangle mesh processing library",
  "homepage": "https://github.com/cdcseacave/halfmesh",
  "license": "MIT",
  "builtin-baseline": "0ac8df3b98e3afcd8bf075fa74a6bd2c32613345",
  "dependencies": [
    "bshoshany-thread-pool",
    "eigen3",
    {
      "name": "opencv4",
      "default-features": false,
      "features": ["eigen", "fs", "intrinsics", "jpeg", "png", "thread"]
    },
    "tinyply",
    "tinygltf"
  ],
  "features": {
    "tests": { "description": "Build unit tests", "dependencies": ["gtest"] },
    "tools": { "description": "Build example CLIs" },
    "crosschecks": {
      "description": "Build third-party cross-check tests (dev/CI-internal, not shipped)",
      "dependencies": ["gtest", "libigl"]
    },
    "bench": {
      "description": "Heavier benchmark baselines (CGAL segmentation/param; SuiteSparse for the geometry-central/BFF solver)",
      "dependencies": ["cgal", "suitesparse"]
    }
  }
}
